  for item_coffee in MENU.keys():
      if Coffee_Type==item_coffee:
          for item_resources in resources:
              if resources[item_resources]<MENU[item_coffee]["ingredients"][item_resources]:
                 print(f"sorry there's not enough {item_resources}")
