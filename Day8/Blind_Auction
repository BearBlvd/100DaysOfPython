from art import logo
print(logo)

bid_done=False
Bids={}

while bid_done==False:
    name=input("What is your name ?: ")
    bid=input("what is your Bid : ")
    Bids[name]=bid
    result=input("Are there any other bidder 'yes' or 'no': ")
    print("\n"*100)

    if result=="no":
        bid_done=True

if bid_done==True:
    highest=max(Bids.values())

    for names in Bids:

        if highest==Bids[names]:
            name=names

print(f"The winner is {name} with a bid of ${highest}")
