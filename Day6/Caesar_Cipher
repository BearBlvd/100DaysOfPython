def caeser(text,shift,direction):
    word_en=[]
    if direction=="decode":
         shift*=-1
         
    for Letter in text: 
        if Letter in alphabet:
            word_pos=alphabet.index(Letter)
            new_pos=word_pos+shift
            word_en.append(alphabet[new_pos])
        else:
            word_en.append(Letter)
     
    word="".join(word_en)

    return word

